# Release lanes for the iPhone app (mobile/ios, generated by XcodeGen).
#
#   (cd mobile/ios && xcodegen)        # the .xcodeproj is not committed
#   scripts/build_core_apple.sh        # the Rust core the package links
#   bundle exec fastlane ios tramline version_name:1.0.0 version_code:42
#
# .github/workflows/tramline-ios.yml runs the tramline lane for Tramline.

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "TaktMobile.xcodeproj")
SCHEME = "TaktMobile"
TEAM_ID = "6NQNU5YSC2"

# target -> bundle identifier, for everything the archive signs.
TARGETS = {
  "TaktMobile"  => "uk.co.maybeitssoftware.takt",
  "TaktWidgets" => "uk.co.maybeitssoftware.takt.widgets",
}

def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV["ASC_KEY_ID"],
    issuer_id:             ENV["ASC_ISSUER_ID"],
    key_content:           ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
  )
end

platform :ios do
  desc "Tramline: build a signed IPA with Tramline's version and upload it to TestFlight"
  lane :tramline do |options|
    version_name = options[:version_name].to_s.strip
    version_code = options[:version_code].to_s.strip
    UI.user_error!("version_name is required") if version_name.empty?
    UI.user_error!("version_code must be a positive integer") unless version_code.match?(/\A[1-9]\d*\z/)
    UI.user_error!("#{PROJECT} is missing: run xcodegen first") unless File.directory?(PROJECT)

    setup_ci
    api_key = asc_api_key

    match(
      type:           "appstore",
      app_identifier: TARGETS.values,
      api_key:        api_key,
      readonly:       true,
    )

    TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        path:                  PROJECT,
        use_automatic_signing: false,
        team_id:               TEAM_ID,
        code_sign_identity:    "Apple Distribution",
        bundle_identifier:     bundle_id,
        targets:               [target],
        profile_name:          "match AppStore #{bundle_id}",
      )
    end

    # MARKETING_VERSION / CURRENT_PROJECT_VERSION feed CFBundleShortVersionString
    # and CFBundleVersion in both Info.plists (project.yml), so overriding them
    # here stamps the app and the widget extension alike.
    build_app(
      project:          PROJECT,
      scheme:           SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: File.join(ROOT, "build", "tramline"),
      xcargs:           "MARKETING_VERSION=#{version_name.shellescape} CURRENT_PROJECT_VERSION=#{version_code}",
      export_options: {
        signingStyle:         "manual",
        teamID:               TEAM_ID,
        provisioningProfiles: TARGETS.values.to_h { |id| [id, "match AppStore #{id}"] },
      },
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
    )
  end
end
