# Copy to .env beside docker-compose.yml and fill in. See docs/self-hosting.md.

# The password for the bundled Postgres. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Your Supabase project: Project Settings -> API -> Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional. The project's secret API key (sb_secret_...), so "Delete account"
# in the apps works. Never put it in an app.
SUPABASE_SECRET_KEY=

# Optional. Only for a project still signing with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Optional. For `docker compose --profile tls up`: the domain Caddy serves
# (and gets a certificate for), e.g. sync.example.com.
TAKT_DOMAIN=

# Optional. The port on this machine the server answers on, plain HTTP.
HOST_PORT=8080
