<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately unsandboxed, matching the Debug entitlements.
	     Sandboxing is only mandatory for Mac App Store distribution; this app
	     ships as a notarized DMG, and notarization does not require it.

	     It also cannot be turned back on as-is: under the sandbox, keychain
	     access is scoped to an access group that comes from the
	     `com.apple.application-identifier` entitlement, which is only granted by
	     an embedded provisioning profile. The project signs manually with no
	     `PROVISIONING_PROFILE_SPECIFIER`, so the sandboxed build had no access
	     group and every `SecItemAdd` in `CheckvistCredentialStore` /
	     `GoogleCalendarOAuthTokenStore` failed — the app silently forgot the
	     Checkvist remote key on every relaunch. Re-enabling the sandbox means
	     also provisioning a profile and adding `keychain-access-groups`. -->
	<key>com.apple.security.app-sandbox</key>
	<false />
	<key>com.apple.security.files.user-selected.read-write</key>
	<true />
	<key>com.apple.security.network.client</key>
	<true />
	<!-- Required by `GoogleOAuthLoopbackReceiver`, which binds a short-lived
	     local NWListener to receive the Google OAuth redirect. Without this the
	     listener fails to start under the sandbox and sign-in is impossible. -->
	<key>com.apple.security.network.server</key>
	<true />
</dict>
</plist>
